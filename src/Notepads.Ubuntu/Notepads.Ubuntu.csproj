<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Uno's GTK runtime produces a native Linux desktop application. -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Notepads</RootNamespace>
    <AssemblyName>Notepads</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ApplicationIcon>Assets\Square44x44Logo.targetsize-256_altform-lightunplated-dev.png</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Link the existing implementation rather than maintaining a Linux-only UI. -->
    <Compile Include="..\Notepads\**\*.cs" Exclude="..\Notepads\Program.cs;..\Notepads\Services\AnalyticsService.cs;..\Notepads\bin\**;..\Notepads\obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="Program.cs" />
    <Compile Include="Platform\AnalyticsService.cs" />
    <ApplicationDefinition Include="..\Notepads\App.xaml" Link="App.xaml" />
    <Page Include="..\Notepads\**\*.xaml" Exclude="..\Notepads\App.xaml;..\Notepads\bin\**;..\Notepads\obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Notepads\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\Notepads\Resource\**\*" Link="Resource\%(RecursiveDir)%(Filename)%(Extension)" />
    <PRIResource Include="..\Notepads\Strings\**\*.resw" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Notepads.Controls\Notepads.Controls.Ubuntu.csproj" />
    <PackageReference Include="Uno.UI" Version="5.5.37" />
    <PackageReference Include="Uno.UI.Runtime.Skia.Gtk" Version="5.5.37" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="Uno.Microsoft.Xaml.Behaviors.Uwp.Managed" Version="2.4.2" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <PackageReference Include="UTF.Unknown" Version="2.5.1" />
  </ItemGroup>
</Project>

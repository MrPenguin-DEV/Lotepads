<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <!-- The controls and XAML are shared with the original application. -->
    <TargetFramework>net8.0-desktop</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Notepads.Controls</RootNamespace>
    <AssemblyName>Notepads.Controls</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
    <Page Include="**\*.xaml" Exclude="bin\**;obj\**" />
    <Content Include="Properties\Notepads.Controls.rd.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Uno.UI" Version="5.5.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.UI" Version="7.1.3" />
  </ItemGroup>
</Project>
